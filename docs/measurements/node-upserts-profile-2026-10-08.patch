+pub(crate) mod upsert_profile {
+    use std::{cell::RefCell,collections::BTreeMap,time::Instant};
+    struct Frame { name: &'static str, start: Instant, child: u128 }
+    #[derive(Default)]
+    struct Data { stack: Vec<Frame>, totals: BTreeMap<&'static str, (u128,u128,usize)> }
+    thread_local! { static DATA: RefCell<Data> = RefCell::new(Data::default()); }
+    pub struct Span;
+    pub fn span(name: &'static str) -> Span {
+        DATA.with_borrow_mut(|d| d.stack.push(Frame { name,start:Instant::now(),child:0 }));
+        Span
+    }
+    pub fn time<T>(name: &'static str, action: impl FnOnce() -> T) -> T { let _s=span(name); action() }
+    impl Drop for Span {
+        fn drop(&mut self) {
+            DATA.with_borrow_mut(|d| {
+                let frame=d.stack.pop().unwrap();
+                let elapsed=frame.start.elapsed().as_nanos();
+                let total=d.totals.entry(frame.name).or_default();
+                total.0 += elapsed; total.1 += elapsed.saturating_sub(frame.child); total.2 += 1;
+                if let Some(parent)=d.stack.last_mut() { parent.child += elapsed; }
+                else {
+                    let report=d.totals.iter().map(|(name,(inclusive,exclusive,calls))|
+                        (*name,serde_json::json!({"inclusive_ms":*inclusive as f64/1e6,"exclusive_ms":*exclusive as f64/1e6,"calls":calls}))).collect::<BTreeMap<_,_>>();
+                    eprintln!("UPSERT_PROFILE {}",serde_json::to_string(&report).unwrap());
+                    d.totals.clear();
+                }
+            });
+        }
+    }
+}
